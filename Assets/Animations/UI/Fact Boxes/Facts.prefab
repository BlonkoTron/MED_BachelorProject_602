    - target: {fileID: 1570929352044036052, guid: daadc54180a44064dbcbc655a13a4e4b, type: 3}
      propertyPath: m_text
      value: "Opdr\xE6ttelse af kv\xE6g til billig k\xF8dproduktion er en stor industri
        i Sydamerika. \n\nStore omr\xE5der af Regnskoven i Amazonas er blevet ryddet
        kun til gr\xE6sning af kv\xE6g.\n\nKv\xE6gets tunge v\xE6gt presser jordpartiklerne
        t\xE6t sammen, s\xE5 luft og vand ikke kan tr\xE6nge igennem. Dette kaldes
        jordpakning og g\xF8r jorden uegnet til b\xE5de afgr\xF8der og andet planteliv.\n\nTip:\nDette
        felt skader jorden meget."
      objectReference: {fileID: 0}
