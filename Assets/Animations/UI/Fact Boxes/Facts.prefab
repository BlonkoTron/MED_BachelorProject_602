    - target: {fileID: 1570929352044036052, guid: daadc54180a44064dbcbc655a13a4e4b, type: 3}
      propertyPath: m_text
      value: "Regnskoven er en af de mest biodiverse omr\xE5der p\xE5 kloden og er
        reservoir for n\xE6ringstoffer, vand og tonsvis af carbon.\n\nSt\xF8rstedelen
        af n\xE6ringsstofferne sidder i plante og dyrelivet og ikke i jorden.\n\nRegnskoven
        har en hurtig n\xE6ringstofsscyklus.\n\nTips:\nDit folk bliver sure, hvis
        du fjerner skov.\n\nDette felt skader ikke jorden."
      objectReference: {fileID: 0}
