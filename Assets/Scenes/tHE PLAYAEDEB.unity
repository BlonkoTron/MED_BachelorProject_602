    - target: {fileID: 2710704225074493932, guid: 9e0380cb3ec98614e8b1ec39531d7382, type: 3}
      propertyPath: m_text
      value: "Skovlandbrug er en b\xE6redygtig landbrugsmetode, der kombinere afgr\xF8der
        og tr\xE6er i et sammenspil der efterligner regnskovens naturlige struktur.\n\nMan
        gror kombinationsafgr\xF8der som kakao, acai, kaffe og andre afgr\xF8der.\n\nBruges
        til genoprettelse af natur i degraderede jorde og beskytter biodiversiteten.\n\nTip:\nDette
        felt skader jorden minimalt."
      objectReference: {fileID: 0}
    - target: {fileID: 6283865408178534559, guid: 9e0380cb3ec98614e8b1ec39531d7382, type: 3}
      propertyPath: m_Name
      value: Facts
      objectReference: {fileID: 0}
